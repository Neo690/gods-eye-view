node_modules
dist
# Credential files. `.env` alone is not enough: Vite's loadEnv (see
# server/standalone/vite.config.js) and scripts/setup-doctor.mjs both read the
# full dotenv ladder — .env, .env.local, .env.<mode> and .env.<mode>.local —
# so a key placed in any of them is live for the app. Only .env was ignored,
# leaving the other three committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
# ANFR radio-site extract built by `npm run towers:build` (63 MB upstream).
data/anfr/
# Browser QA gate evidence (screenshots, console and network dumps).
qa-artifacts/
# Playwright MCP session logs: browser consoles can carry tokens in URLs.
.playwright-mcp/
# Local Claude Code settings and preview configs.
.claude/
.DS_Store
.gstack/
3d-models/
pinokio/ENVIRONMENT
pinokio/.installed

# Transient: a release interrupted mid-assembly (npm run changelog recovers it)
changelog.d/.assembling/

# Which CI build `npm run apk:install` last put on the local phone.
.gev-apk-install.json

# Android shell build output and the bundled web copy
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/www/
android/*.apk

# Local signing key for CI builds (never committed)
.signing/

# Desktop shell build output: the staged payload copied into the installer, and
# electron-builder's release directory.
desktop/.payload/
desktop/release/
desktop/node_modules/

# The iOS studio app's packager output, its dependencies, and the checkout path
# `build-installer.mjs` wrote into the package: that path belongs to whoever ran
# the build, not to the repository.
desktop/studio/node_modules/
desktop/studio/release/
desktop/studio/project-root.json

# iOS shell: the bundle `npm run ios:payload` stages, Xcode's output, and the
# project XcodeGen derives from ios/project.yml (the spec is the source of truth).
# The folder itself stays in the repository: XcodeGen refuses a folder
# reference to a path that does not exist, so a fresh clone must be able to
# generate the project before the first `npm run ios:payload`.
ios/GodsEyeView/www/*
!ios/GodsEyeView/www/.gitkeep
ios/GodsEyeView.xcodeproj/
ios/build/
ios/DerivedData/
ios/*.ipa
# xtool packs the built .app here (`cd ios && xtool dev`), and SwiftPM keeps
# its scratch and module cache in .build/ beside the package manifest.
ios/xtool/
ios/.build/
# xtool writes a build-server description here for editors
ios/.bsp/
